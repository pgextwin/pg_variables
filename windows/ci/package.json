{
  "schemaVersion": 1,
  "distribution": "dll-sql",
  "files": [
    {
      "source": "upstream",
      "path": "pg_variables.dll",
      "destination": "lib/pg_variables.dll",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "pg_variables.control",
      "destination": "share/extension/pg_variables.control",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": [
        "zip"
      ],
      "optional": true
    },
    {
      "source": "packaging",
      "path": "README.md",
      "destination": "PGEXTWIN-README.md",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "pg_variables--1.2.sql",
      "destination": "share/extension/pg_variables--1.2.sql",
      "targets": [
        "install",
        "zip"
      ]
    }
  ],
  "packageInfo": [
    "pg_variables unofficial Windows x64 package",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref: {upstreamRef}",
    "Upstream commit: {upstreamCommit}",
    "Version: {version}",
    "PostgreSQL major: {pgMajor}",
    "PostgreSQL tested: {pgTested}",
    "Architecture: Windows x64"
  ],
  "packageInfoFinalNewline": false,
  "sqlVersion": "1.2"
}
